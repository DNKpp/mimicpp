        <mxCell id="l3" parent="1" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;fontColor=#1E293B;fontSize=12;spacingLeft=4;" value="&lt;table style=&quot;border-collapse: collapse;&quot;&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;padding: 0 0 2px 0;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#475569&quot;&gt;Notation&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding: 0 0 0 28px;&quot;&gt;&lt;/td&gt;&lt;td colspan=&quot;2&quot; style=&quot;padding: 0 0 2px 0;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#475569&quot;&gt;Highlighting&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding: 0 10px 0 12px; vertical-align: top;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#64748B&quot;&gt;[ ]&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding: 0 10px 0 0; vertical-align: top;&quot;&gt;&lt;font color=&quot;#475569&quot;&gt;optional&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding: 0 0 0 28px;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding: 0 10px 0 12px; vertical-align: top;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;Mock&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding: 0 10px 0 0; vertical-align: top;&quot;&gt;&lt;font color=&quot;#475569&quot;&gt;framework API&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding: 0 10px 0 12px; vertical-align: top;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#64748B&quot;&gt;...&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding: 0 10px 0 0; vertical-align: top;&quot;&gt;&lt;font color=&quot;#475569&quot;&gt;repeatable&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;padding: 0 0 0 28px;&quot;&gt;&lt;/td&gt;&lt;td style=&quot;padding: 0 10px 0 12px; vertical-align: top;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#9D174D&quot;&gt;const&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding: 0 10px 0 0; vertical-align: top;&quot;&gt;&lt;font color=&quot;#475569&quot;&gt;C++ keyword&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style