3B&quot;&gt;(&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt; [&lt;/font&gt;&lt;/b&gt;&lt;i&gt;&lt;font color=&quot;#B45309&quot;&gt;param-types&lt;/font&gt;&lt;/i&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt; ...] &lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#1E293B&quot;&gt;)&lt;/font&gt;&lt;/b&gt; &lt;i&gt;&lt;font color=&quot;#B45309&quot;&gt;specs&lt;/font&gt;&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding: 0 10px 0 0; vertical-align: top;&quot;&gt;&lt;i&gt;&lt;font color=&quot;#B45309&quot;&gt;specs&lt;/font&gt;&lt;/i&gt;&lt;/td&gt;&lt;td style=&quot;padding: 0 10px 0 0; vertical-align: top;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt;:=&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding: 0 10px 0 0; vertical-align: top;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt;[&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#9D174D&quot;&gt;const&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt;] [&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#9D174D&quot;&gt;&amp;amp;&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt;|&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#9D174D&quot;&gt;&amp;amp;&amp;amp;&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt;] [&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#9D174D&quot;&gt;noexcept&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt;]&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding: 0 10px 0 0; vertical-align: top;&quot;&gt;&lt;i&gt;&lt;font color=&quot;#B45309&quot;&gt;member-specs&lt;/font&gt;&lt;/i&gt;&lt;/td&gt;&lt;td style=&quot;padding: 0 10px 0 0; vertical-align: top;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt;:=&lt;/font&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding: 0 10px 0 0; vertical-align: top;&quot;&gt;&lt;i&gt;&lt;font color=&quot;#B45309&quot;&gt;specs&lt;/font&gt;&lt;/i&gt;&lt;b