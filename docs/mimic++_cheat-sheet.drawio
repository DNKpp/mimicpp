        <mxCell id="c13" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=nowrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#EFEBE9;strokeColor=#795548;strokeWidth=2;fontColor=#1E293B;fontSize=12;" value="&lt;b&gt;&lt;span style=&quot;font-size: 14px; background-color: #795548; color: #FFFFFF;&quot;&gt;&amp;nbsp;&amp;nbsp;Expectation Scopes&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;/b&gt;&lt;div style=&quot;padding-left: 12px;&quot;&gt;&lt;i&gt;&lt;font color=&quot;#64748B&quot;&gt;// Every expectation is verified when its scope ends.&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#475569&quot;&gt;Prefix of a single expectation (&lt;/font&gt;&lt;/b&gt;&lt;i&gt;&lt;span style=&quot;background-color: #795548; color: #FFFFFF;&quot;&gt;&amp;nbsp;prefix&amp;nbsp;&lt;/span&gt;&lt;/i&gt;&lt;b&gt;&lt;font color=&quot;#475569&quot;&gt;), one of:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#94A3B8&quot;&gt;•&amp;nbsp;&lt;/font&gt;&lt;b&gt;&lt;font color=&quot;#5D4037&quot;&gt;MIMICPP_SCOPED_EXPECTATION&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#94A3B8&quot;&gt;•&amp;nbsp;&lt;/font&gt;&lt;b&gt;&lt;font color=&quot;#5D4037&quot;&gt;SCOPED_EXP&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#94A3B8&quot;&gt;•&amp;nbsp;&lt;/font&gt;&lt;b&gt;&lt;font color=&quot;#5D4037&quot;&gt;ScopedExpectation&lt;/font&gt;&lt;/b&gt; &lt;i&gt;&lt;font color=&quot;#B45309&quot;&gt;name&lt;/font&gt;&lt;/i&gt; &lt;b&gt;&lt;font color=&quot;#1E293B&quot;&gt;=&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#475569&quot;&gt;Collects many expectations (note the plural):&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#94A3B8&quot;&gt;•&amp;nbsp;&lt;/font&gt;&lt;b&gt;&lt;font color=&quot;#5D4037&quot;&gt;ScopedExpectations&lt;/font&gt;&lt;/b&gt; &lt;i&gt;&lt;font color=&quot;#B45309&quot;&gt;collector&lt;/font&gt;&lt;/i&gt;&lt;b&gt;&lt;font color=&quot;#1E293B&quot;&gt;;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;&lt;font color=&quot;#B45309&quot;&gt;collector&lt;/font&gt;&lt;/i&gt; &lt;b&gt;&lt;font color=&quot;#1E293B&quot;&gt;+=&lt;/font&gt;&lt;/b&gt; &lt;i&gt;&lt;font color=&quot;#B45309&quot;&gt;mock&lt;/font&gt;&lt;/i&gt;&lt;b&gt;&lt;font color=&quot;#1E293B&quot;&gt;.&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;expect_call&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#1E293B&quot;&gt;(&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt; ... &lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#1E293B&quot;&gt;)&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt; [&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#9D174D&quot;&gt;and&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt; ...]&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#1E293B&quot;&gt;;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;&lt;font color=&quot;#64748B&quot;&gt;// all are verified when &lt;/font&gt;&lt;/i&gt;&lt;i&gt;&lt;font color=&quot;#B45309&quot;&gt;collector&lt;/font&gt;&lt;/i&gt;&lt;i&gt;&lt;font color=&quot;#64748B&quot;&gt; is destroyed&lt;/font&gt;&lt;/i&gt;&lt;/div&gt;" vertex="1">
