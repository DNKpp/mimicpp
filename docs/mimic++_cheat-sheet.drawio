        <mxCell id="c14" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=nowrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#F1F8E9;strokeColor=#558B2F;strokeWidth=2;fontColor=#1E293B;fontSize=12;" value="&lt;b&gt;&lt;span style=&quot;font-size: 14px; background-color: #558B2F; color: #FFFFFF;&quot;&gt;&amp;nbsp;&amp;nbsp;Sequences&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;/b&gt;&lt;div style=&quot;padding-left: 12px;&quot;&gt;&lt;font color=&quot;#94A3B8&quot;&gt;•&amp;nbsp;&lt;/font&gt;&lt;b&gt;&lt;font color=&quot;#33691E&quot;&gt;Sequence&lt;/font&gt;&lt;/b&gt;&lt;i&gt;&lt;font color=&quot;#64748B&quot;&gt; = &lt;/font&gt;&lt;/i&gt;&lt;b&gt;&lt;font color=&quot;#33691E&quot;&gt;LazySequence&lt;/font&gt;&lt;/b&gt;&amp;nbsp;&lt;i&gt;&lt;font color=&quot;#64748B&quot;&gt;// makes the least possible progress&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#94A3B8&quot;&gt;•&amp;nbsp;&lt;/font&gt;&lt;b&gt;&lt;font color=&quot;#33691E&quot;&gt;GreedySequence&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/font&gt;&lt;/b&gt;&amp;nbsp;&lt;i&gt;&lt;font color=&quot;#64748B&quot;&gt;// makes the most possible progress&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#94A3B8&quot;&gt;•&amp;nbsp;&lt;/font&gt;&lt;strike&gt;&lt;font color=&quot;#94A3B8&quot;&gt;SequenceT&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/font&gt;&lt;/strike&gt;&lt;i&gt;&lt;font color=&quot;#64748B&quot;&gt;&amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;// deprecated alias of Sequence&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#94A3B8&quot;&gt;•&amp;nbsp;&lt;/font&gt;&lt;b&gt;&lt;font color=&quot;#33691E&quot;&gt;expect::in_sequence&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#1E293B&quot;&gt;(&lt;/font&gt;&lt;/b&gt; &lt;i&gt;&lt;font color=&quot;#B45309&quot;&gt;s&lt;/font&gt;&lt;/i&gt; &l