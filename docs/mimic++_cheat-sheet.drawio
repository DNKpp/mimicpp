        <mxCell id="c15" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=nowrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#F3E5F5;strokeColor=#8E24AA;strokeWidth=2;fontColor=#1E293B;fontSize=12;" value="&lt;b&gt;&lt;span style=&quot;font-size: 14px; background-color: #8E24AA; color: #FFFFFF;&quot;&gt;&amp;nbsp;&amp;nbsp;Requirements&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;/b&gt;&lt;div style=&quot;padding-left: 12px;&quot;&gt;&lt;font color=&quot;#94A3B8&quot;&gt;•&amp;nbsp;&lt;/font&gt;&lt;b&gt;&lt;font color=&quot;#7B1FA2&quot;&gt;expect::arg&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#1E293B&quot;&gt;&amp;lt;&lt;/font&gt;&lt;/b&gt;&lt;i&gt;&lt;font color=&quot;#B45309&quot;&gt;i&lt;/font&gt;&lt;/i&gt;&lt;b&gt;&lt;font color=&quot;#1E293B&quot;&gt;&amp;gt;&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#1E293B&quot;&gt;(&lt;/font&gt;&lt;/b&gt; &lt;i&gt;&lt;span style=&quot;background-color: #00897B; color: #FFFFFF;&quot;&gt;&amp;nbsp;matcher&amp;nbsp;&lt;/span&gt;&lt;/i&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt; [&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#1E293B&quot;&gt;,&lt;/font&gt;&lt;/b&gt; &lt;i&gt;&lt;font color=&quot;#B45309&quot;&gt;projection&lt;/font&gt;&lt;/i&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt;]&lt;/font&gt;&lt;/b&gt; &lt;b&gt;&lt;font color=&quot;#1E293B&quot;&gt;)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#94A3B8&quot;&gt;•&amp;nbsp;&lt;/font&gt;&lt;b&gt;&lt;font color=&quot;#7B1FA2&quot;&gt;expect::args&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#1E293B&quot;&gt;&amp;lt;&lt;/font&gt;&lt;/b&gt;&lt;i&gt;&lt;font color=&quot;#B45309&quot;&gt;i&lt;/font&gt;&lt;/i&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt; [&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#1E293B&quot;&gt;,&lt;/font&gt;&lt;/b&gt; &lt;i&gt;&lt;font color=&quot;#B45309&quot;&gt;is ...&lt;/font&gt;&lt;/i&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt;]&lt;/font&