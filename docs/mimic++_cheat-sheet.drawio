        <mxCell id="c12" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=nowrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontColor=#1E293B;fontSize=12;" value="&lt;div style=&quot;line-height: 16px;&quot;&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b&gt;&lt;span style=&quot;font-size: 14px; background-color: #475569; color: #FFFFFF;&quot;&gt;&amp;nbsp;&amp;nbsp;Expectation Anatomy&amp;nbsp;&amp;nbsp;&lt;br&gt;&lt;/span&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b&gt;&lt;span style=&quot;font-size: 14px; background-color: #475569; color: #FFFFFF;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/b&gt;&lt;/div&gt;&lt;i&gt;&lt;span style=&quot;background-color: #795548; color: #FFFFFF;&quot;&gt;&amp;nbsp;prefix&amp;nbsp;&lt;/span&gt;&lt;/i&gt; &lt;i&gt;&lt;font color=&quot;#B45309&quot;&gt;name&lt;/font&gt;&lt;/i&gt;&lt;b&gt;&lt;font color=&quot;#1E293B&quot;&gt;.&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;expect_call&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#1E293B&quot;&gt;(&lt;/font&gt;&lt;/b&gt; &lt;i&gt;&lt;span style=&quot;background-color: #00897B; color: #FFFFFF;&quot;&gt;&amp;nbsp;matchers&amp;nbsp;&lt;/span&gt;&lt;/i&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt; ...&lt;/font&gt;&lt;/b&gt; &lt;b&gt;&lt;font color=&quot;#1E293B&quot;&gt;)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#475569&quot;&gt;optional, in any order:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt;[&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#9D174D&quot;&gt;and&lt;/font&gt;&lt;/b&gt; &lt;i&gt;&lt;span style=&quot;background-color: #8E24AA; color: #FFFFFF;&quot;&gt;&amp;nbsp;requirements&amp;nbsp;&lt;/span&gt;&lt;/i&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt; ...]&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt;[&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#9D174D&quot;&gt;and&lt;/font&gt;&lt;/b&gt; &lt;i&gt;&lt;span style=&quot;background-color: #558B2F; color: #FFFFFF;&quot;&gt;&amp;nbsp;sequences&amp;nbsp;&lt;/span&gt;&lt;/i&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt; ...]&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt;[&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#9D174D&quot;&gt;and&lt;/font&gt;&lt;/b&gt; &lt;i&gt;&lt;span style=&quot;background-color: #1E88E5; color: #FFFFFF;&quot;&gt;&amp;nbsp;side-effects&amp;nbsp;&lt;/span&gt;&lt;/i&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt; ...]&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt;[&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#9D174D&quot;&gt;and&lt;/font&gt;&lt;/b&gt; &lt;i&gt;&lt;span style=&quot;background-color: #3949AB; color: #FFFFFF;&quot;&gt;&amp;nbsp;times&amp;nbsp;&lt;/span&gt;&lt;/i&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt;]&lt;/font&gt;&lt;/b&gt;&lt;i&gt;&lt;font color=&quot;#64748B&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;// at most once; &lt;/font&gt;&lt;/i&gt;&lt;b&gt;&lt;i&gt;&lt;font color=&quot;#475569&quot;&gt;defaults&lt;/font&gt;&lt;/i&gt;&lt;/b&gt;&lt;i&gt;&lt;font color=&quot;#64748B&quot;&gt; to expect::once()&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt;[&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#9D174D&quot;&gt;and&lt;/font&gt;&lt;/b&gt; &lt;i&gt;&lt;span style=&quot;background-color: #E53935; color: #FFFFFF;&quot;&gt;&amp;nbsp;finalizer&amp;nbsp;&lt;/span&gt;&lt;/i&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt;]&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#1E293B&quot;&gt;;&lt;/font&gt;&lt;/b&gt;&lt;i&gt;&lt;font color=&quot;#64748B&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;// at most once; &lt;/font&gt;&lt;/i&gt;&lt;b&gt;&lt;i&gt;&lt;font color=&quot;#475569&quot;&gt;required&lt;/font&gt;&lt;/i&gt;&lt;/b&gt;&lt;i&gt;&lt;font color=&quot;#64748B&quot;&gt; for non-void return types&lt;/font&gt;&lt;/i&gt;&lt;/div&gt;" vertex="1">
