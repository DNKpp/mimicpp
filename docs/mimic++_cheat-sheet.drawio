1&quot;&gt;]&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;MAKE_OVERLOADED_MEMBER_MOCK&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#1E293B&quot;&gt;(&lt;/font&gt;&lt;/b&gt; &lt;i&gt;&lt;font color=&quot;#B45309&quot;&gt;fn_name&lt;/font&gt;&lt;/i&gt;&lt;b&gt;&lt;font color=&quot;#1E293B&quot;&gt;, &lt;/font&gt;&lt;/b&gt;&lt;i&gt;&lt;font color=&quot;#B45309&quot;&gt;overload&lt;/font&gt;&lt;/i&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt; [&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#1E293B&quot;&gt;,&lt;/font&gt;&lt;/b&gt; &lt;i&gt;&lt;font color=&quot;#B45309&quot;&gt;overload&lt;/font&gt;&lt;/i&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt; ...]&lt;/font&gt;&lt;/b&gt; &lt;b&gt;&lt;font color=&quot;#1E293B&quot;&gt;);&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt;[&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;MIMICPP_&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt;]&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;MAKE_MEMBER_MOCK_WITH_THIS&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt; / &lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt;[&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;MIMICPP_&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt;]&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;MAKE_OVERLOADED_MEMBER_MOCK_WITH_THIS&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;&lt;font color=&quot;#64748B&quot;&gt;// same arguments; prepends &lt;/font&gt;&lt;/i&gt;&lt;b&gt;&lt;font color=&quot;#9D174D&quot;&gt;this&lt;/font&gt;&lt;/b&gt;&lt;i&gt;&lt;font color=&quot;#64748B&quot;&gt; as first argument; requires &lt;/font&gt;&lt;/i&gt;&lt;b&gt;&lt;font color=&quot;#9D174D&quot;&gt;using&lt;/font&gt;&lt;/b&gt; &lt;font color=&quot;#1E293B&quot;&gt;self_type&lt;/font&gt;&lt;b&gt;&lt;font color=&quot;#1E293B&quot;&gt; = &lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt;...&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#1E293B&quot;&gt;;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#B45309&quot;&gt;fn_name_&lt;/font&gt;&lt;/i&gt;&lt;b&gt;&lt;font color=&quot;#1E293B&quot;&gt;.&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;expect_call&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#1E293B&quot;&gt;(&lt;/font&gt;&lt;/b&gt; &lt;i&gt;&lt;span style=&quot;background-color: #00897B; color: #FFFFFF;&quot;&gt;&amp;nbsp;matchers&amp;nbsp;&lt;/span&gt;&lt;/i&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt; ...&lt;/font&gt;&lt;/b&gt; &lt;b&gt;&lt;font color=&quot;#1E293B&quot;&gt;)&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt; [&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#9D174D&quot;&gt;and&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt; ...]&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#1E293B&quot;&gt;;&lt;/font&gt;&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;&lt;font color=&quot;#64748B&quot;&gt;// the mock member is named &lt;/font&gt;&lt;/i&gt;&lt;i&gt;&lt;font color=&quot;#B45309&quot;&gt;fn_name_&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#64748B&quot;&gt;Advanced: &lt;/font&gt;&lt;/i&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt;[&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;MIMICPP_&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt;]&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;MAKE_FACADE_EXT&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt; / &lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt;[&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;MIMICPP_&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#7C8BA1&quot;&gt;]&lt;/font&gt;&lt;/b&gt;&lt;b&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;MAKE_OVERLOADED_FACADE_EXT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;&lt;font color=&quot;#64748B&quot;&gt;// leading &lt;/font&gt;&lt;/i&gt;&lt;i&gt;&lt;font color=&quot;#B45309&quot;&gt;traits&lt;/font&gt;&lt;/i&gt;&lt;b&gt;&lt;font color=&quot;#1E293B&quot;&gt;, &lt;/font&gt;&lt;/b&gt;&lt;i&gt;&lt;font color=&quot;#B45309&quot;&gt;target_name&lt;/font&gt;&lt;/i&gt;&lt;b&gt;&lt;font color=&quot;#1E293B&quot;&gt;, &lt;/font&gt;&lt;/b&gt;&lt;i&gt;&lt;font color=&quot;#B45309&quot;&gt;fn_name&lt;/font&gt;&lt;/i&gt;&lt;b&gt;&lt;font color=&quot;#1E293B&quot;&gt;, &lt;/font&gt;&lt;/b&gt;&lt;i&gt;&lt;font color=&quot;#B45309&quot;&gt;linkage&lt;/font&gt;&lt;/i&gt;&lt;i&gt;&lt;font color=&quot;#64748B&quot;&gt;, followed by the remaining arguments of the respective member-mock macro&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;strike&gt;&lt;font color=&quot;#94A3B8&quot;&gt;[MIMICPP_]MOCK_METHOD / [MIMICPP_]MOCK_OVERLOADED_METHOD&lt;/font&gt;&lt;/strike&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;&lt;font color=&quot;#64748B&quot;&gt;// deprecated, use the MAKE_*_MEMBER_MOCK macros&lt;/font&gt;&lt;/i&gt;" vertex="1">
